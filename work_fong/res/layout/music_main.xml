<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musicRoot"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/music_bg">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/musicTitle"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/music_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20.0sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/musicSearch"
            android:layout_width="44.0dip"
            android:layout_height="44.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/music_search"
            android:src="@drawable/ic_music_search"
            android:tint="?attr/colorOnSurface" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/musicTabs"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:orientation="horizontal"
        android:paddingStart="16.0dip"
        android:paddingEnd="16.0dip">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabSongs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_tab_songs"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabAlbums"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_tab_albums"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabArtists"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_tab_artists"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabHistory"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_tab_history"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabPlaylists"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_tab_playlists"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

        <View
            android:layout_width="0.0dip"
            android:layout_height="1.0dip"
            android:layout_weight="1.0" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/musicScan"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12.0dip"
            android:paddingEnd="12.0dip"
            android:text="@string/music_rescan"
            android:textColor="@color/selector_control"
            android:textSize="15.0sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        android:id="@+id/musicEmpty"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:gravity="center"
        android:padding="32.0dip"
        android:text="@string/music_empty"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15.0sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/musicList"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0.0dip"
        android:paddingBottom="64.0dip"
        android:scrollbarStyle="outsideOverlay" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/musicMini"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip"
        android:background="@drawable/music_mini_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10.0dip"
        android:paddingEnd="6.0dip"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/miniCover"
            android:layout_width="44.0dip"
            android:layout_height="44.0dip"
            android:background="@drawable/music_cover_round"
            android:clipToOutline="true"
            android:contentDescription="@string/music_title"
            android:scaleType="centerCrop"
            android:src="@drawable/music_cover_placeholder" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginStart="10.0dip"
            android:layout_weight="1.0"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/miniTitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14.0sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/miniArtist"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12.0sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/miniPrev"
            android:layout_width="42.0dip"
            android:layout_height="42.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/music_prev"
            android:src="@drawable/ic_music_prev"
            android:tint="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/miniPlay"
            android:layout_width="46.0dip"
            android:layout_height="46.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/music_play"
            android:src="@drawable/ic_music_play"
            android:tint="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/miniNext"
            android:layout_width="42.0dip"
            android:layout_height="42.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/music_next"
            android:src="@drawable/ic_music_next"
            android:tint="?attr/colorOnSurface" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
